# Copy to .env outside any synced vault; replace every GENERATE_* placeholder.
# Use forward slashes for a Windows source path.
ELMO_SOURCE_DIR=C:/path/to/elmo
DB_PASSWORD=GENERATE_RANDOM_HEX_32_BYTES
DATABASE_URL=postgresql://elmo:${DB_PASSWORD}@db:5432/elmo
DEPLOYMENT_MODE=local
APP_URL=http://127.0.0.1:3300
VITE_APP_URL=http://127.0.0.1:3300
BETTER_AUTH_SECRET=GENERATE_RANDOM_HEX_32_BYTES
ELMO_ENCRYPTION_KEY=GENERATE_RANDOM_BASE64_32_BYTES
DISABLE_TELEMETRY=1
# UI-only stub mode; no real AI visibility results or paid provider calls.
SCRAPE_TARGETS=stub:stub
ONBOARDING_LLM_TARGET=stub:stub
TYPESAFE_API_KEY=stub
